# rsync excludes for home-server deploy (deploy.sh --exclude-from). Leading-/ is
# anchored to the repo root. Caches/.git/node_modules/.next are excluded centrally
# by deploy.sh BASE_EXCLUDES. NEVER list .env.prod here — it must ship to the box.

# monitoring/ must NOT be excluded: the prod stack's vector service bind-mounts
# monitoring/vector/vector.yaml. Excluding it meant the file never reached the
# box, so Docker auto-created a DIRECTORY at that path and vector refused to
# start. The dev-only metrics configs that once lived here are gone.

# Dev compose + dev env (prod uses docker-compose.prod.yml + .env.prod)
/docker-compose.yml
/.env
/.env.example

# Repo tooling not needed at runtime
/docs/
/scripts/
/.pre-commit-config.yaml
/.secrets.baseline
/.ruff_cache/
/tsconfig.tsbuildinfo
# Local code-graph index (366M, rewritten live by the GitNexus MCP — races rsync)
/.gitnexus/
