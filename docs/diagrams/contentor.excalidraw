      "text": "def get_provider() -> PaymentProvider:\n    if settings.BILLING_BYPASS_ENABLED:\n        from .bypass_provider import BypassProvider\n        return BypassProvider()\n    from .stripe_provider import StripeProvider\n    return StripeProvider()",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def get_provider() -> PaymentProvider:\n    if settings.BILLING_BYPASS_ENABLED:\n        from .bypass_provider import BypassProvider\n        return BypassProvider()\n    from .stripe_provider import StripeProvider\n    return StripeProvider()",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8T"
