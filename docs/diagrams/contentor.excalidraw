      "boundElements": [],
      "updated": 1792767100366,
      "link": null,
      "locked": false,
      "text": "Caddy never knows tenants: the host name picks the app. Django picks the schema from the host, or from X-Tenant-Domain when Next.js calls it.",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caddy never knows tenants: the host name picks the app. Django picks the schema from the host, or from X-Tenant-Domain when Next.js calls it.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8X"
    },
