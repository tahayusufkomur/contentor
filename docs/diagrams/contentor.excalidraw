      "text": "@api path /api/v1/* /api/health*\n          /api/webhooks/* /api/schema*\nhandle @api    → django:8000\nhandle @static → django:8000\nhandle @admin  → django:8000\n@main host {$CONTENTOR_DOMAIN}\nhandle @main   → nextjs-main:3000\nhandle         → nextjs-customer:3000",
