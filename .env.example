# PostgreSQL
POSTGRES_DB=contentor
POSTGRES_USER=contentor
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=changeme-use-a-real-secret-key
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=*
DJANGO_DEBUG=True

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1

# Platform
CONTENTOR_DOMAIN=localhost
CONTENTOR_SUPERUSERS=admin@contentor.com

# Email (Resend). Set EMAIL_SINK_ENABLED=true (default in dev) to capture outbound email
# instead of sending; read back via GET /api/v1/dev/emails/latest/?to= (prod refuses this flag).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@contentor.com
EMAIL_SINK_ENABLED=true

# Storage (S3-compatible). Dev default = bundled MinIO (make dev). For real
# Hetzner storage, set the four values to the real bucket + endpoint and
# leave AWS_ENDPOINT_EXTERNAL empty.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=contentor-dev-private
AWS_ENDPOINT=http://minio:9000
AWS_ENDPOINT_EXTERNAL=http://localhost:9000
AWS_PRESIGNED_EXPIRY=3600

# Log pipeline (apps.logbook). Vector authenticates to the ingest endpoint
# with this shared secret; compose defaults it in dev, prod requires a real one.
LOGS_INGEST_TOKEN=dev-logs-token

# Frontend
NEXT_PUBLIC_API_URL=http://django:8000
NEXT_PUBLIC_BASE_DOMAIN=localhost

# Live video (LiveCraft, ../livecraft). Unset = fake (inert join links). For real
# video run `make dev` in ../livecraft and set:
# LIVECRAFT_URL=http://host.docker.internal:7800
# LIVECRAFT_API_KEY=dev-key

# AI provider (apps.core.ai): "anthropic" (default) | "cli" | "agentc" (Agent
# Container hub — Gemini CLI on subscription accounts; reach it from Docker via
# the host's tunnel on :39300). AGENTC_CWD is a directory on the HUB host.
# | "gemini" (the Gemini API on GEMINI_API_KEY, billed per token; no queue):
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
# AI_PROVIDER=agentc
# AGENTC_HUB=http://host.docker.internal:39300
# AGENTC_MODEL=gemini-3.7-flash-high
# AGENTC_CWD=/Users/tahayusufkomur/ws/agent-studio-runs
# AGENTC_TIMEOUT_SECONDS=180

# Curated photo catalog (curated-image-api, sibling app). Photography lives in
# that service; contentor searches it and caches used images per tenant.
# CURATED_IMAGE_API_FAKE=true (default in dev/e2e) serves a committed fixture
# catalog so the stack stays offline — unset it and fill in the two values below
# to browse the real catalog locally. Prod refuses the fake flag.
CURATED_IMAGE_API_FAKE=true
# CURATED_IMAGE_API_URL=https://pix4less.com
# CURATED_IMAGE_API_KEY=

# MailCraft integration (sibling app). EMAILCRAFT_BASE_URL defaults to the hosted
# instance (mailcraft.contentor.app) if unset.
EMAILCRAFT_TOKEN=
# EMAILCRAFT_BASE_URL=https://mailcraft.contentor.app

# Google OAuth (Zoom OAuth is configured per-tenant in the DB, not here).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback/

# Billing (Stripe). Production refuses BILLING_BYPASS_ENABLED=true.
#
# To exercise the real Stripe flow locally you must:
#   1. Get a Stripe test-mode `sk_test_*` secret key + `pk_test_*` publishable.
#   2. Create monthly recurring Price IDs in Stripe for Starter and Pro in BOTH
#      USD and EUR (test mode), then drop the `price_*` IDs into the env vars
#      below. `seed_plans` will call `stripe.Price.retrieve` to validate them
#      when STRIPE_SECRET_KEY is set.
#   3. Run `make stripe-listen` (injects --api-key from .env, forwards connect events) and
#      copy the `whsec_*` secret it prints into STRIPE_WEBHOOK_SECRET below.

BILLING_BYPASS_ENABLED=true
PAST_DUE_GRACE_DAYS=7
BILLING_FREE_PLAN_NAME=Free
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_STARTER_EUR=
STRIPE_PRICE_PRO_EUR=

# Web Push (VAPID) — generate with: vapid --gen ; vapid --applicationServerKey
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contentor.app
